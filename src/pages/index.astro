---
import Base from "../layouts/Base.astro";
import CallButton from "../components/CallButton.astro";
import Todo from "../components/Todo.astro";
import { site } from "../data/site";
import {
  afterDelivery,
  commitments,
  faq,
  notDone,
  offers,
  problems,
  sectors,
  steps,
} from "../data/content";
---

<Base>
  <section class="container-page pt-12 pb-16 sm:pt-20 sm:pb-24">
    <p class="eyebrow">Développeur freelance à Marseille</p>
    <h1 class="mt-3 max-w-3xl text-3xl leading-tight font-bold tracking-tight sm:text-5xl">
      Des outils sur mesure pour les TPE et PME de Marseille et de sa région, livrés en quelques semaines, et qui vous appartiennent.
    </h1>
    <p class="lead">
      Je remplace le fichier Excel, le papier ou les messages WhatsApp qui servent à une tâche de chaque semaine par une application simple, construite autour de votre façon de travailler. Utilisable aussi sur téléphone.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <CallButton />
      <a href="#metiers" class="btn-secondary">Voir des exemples par métier</a>
    </div>
    <ul class="mt-10 flex flex-wrap gap-2" aria-label="Métiers">
      {sectors.map((s) => (
        <li>
          <a href={`#${s.id}`} class="inline-block rounded-full border border-line bg-card px-3 py-1.5 text-sm hover:border-brand hover:text-brand">
            {s.name}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-y border-line bg-card section" aria-labelledby="probleme-titre">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Le problème</p>
        <h2 id="probleme-titre" class="h2">Une tâche qui revient chaque semaine, et qui se fait encore à la main</h2>
        <ul class="mt-6 space-y-3">
          {problems.map((p) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card self-start bg-brand-soft border-brand/20">
        <h3 class="text-lg font-semibold">Ma réponse</h3>
        <p class="mt-2">
          Un outil construit autour de votre façon de travailler, avec vos règles et vos exceptions. Il doit se rembourser en 6 à 18 mois grâce au temps gagné.
        </p>
        <p class="mt-4 text-sm font-semibold text-brand">Exemple de calcul</p>
        <p class="mt-1">
          3 personnes qui gagnent 1 heure par jour, c'est environ <strong>700 heures par an</strong>.
        </p>
      </div>
    </div>
  </section>

  <section id="metiers" class="section" aria-labelledby="metiers-titre">
    <div class="container-page">
      <p class="eyebrow">Exemples par métier</p>
      <h2 id="metiers-titre" class="h2">Ce que je peux construire pour vous</h2>
      <p class="lead">
        Voici des exemples d'outils possibles, métier par métier. Ce sont des idées de départ : chaque outil est construit autour de votre entreprise.
      </p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {sectors.map((s) => (
          <article id={s.id} class="card flex flex-col">
            <h3 class="text-lg font-semibold">{s.name}</h3>
            <p class="text-sm text-muted">{s.who}</p>
            <p class="mt-4 border-l-4 border-sun pl-3 font-medium">« {s.question} »</p>
            <p class="mt-4 text-sm font-semibold">Exemples d'outils</p>
            <ul class="mt-2 space-y-1.5">
              {s.tools.map((t) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-brand">✓</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
            {s.note && <p class="mt-4 text-sm text-muted">{s.note}</p>}
          </article>
        ))}
      </div>
      <p class="mt-6 text-muted">
        Votre métier n'est pas dans la liste ? Logistique, industrie, maintenance des machines : si une tâche revient chaque semaine, parlons-en.
      </p>
    </div>
  </section>

  <section id="methode" class="border-y border-line bg-card section" aria-labelledby="methode-titre">
    <div class="container-page">
      <p class="eyebrow">Méthode</p>
      <h2 id="methode-titre" class="h2">Comment se passe un projet</h2>
      <p class="lead">
        Sept étapes, environ 2 mois du premier appel à la fin des retours. Je viens sur place pour comprendre votre métier, puis je développe à distance.
      </p>
      <ol class="mt-10 space-y-6">
        {steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand font-bold text-white">{i + 1}</span>
            <div>
              <h3 class="font-semibold">
                {step.title} <span class="font-normal text-muted">· {step.time}</span>
              </h3>
              <p class="mt-1 text-muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="offres" class="section" aria-labelledby="offres-titre">
    <div class="container-page">
      <p class="eyebrow">Offres et prix</p>
      <h2 id="offres-titre" class="h2">Un forfait par projet, fixé avant de commencer</h2>
      <p class="lead">
        Pas de facturation au temps passé, pas d'abonnement obligatoire. Le prix exact est donné dans le devis, après l'atelier de cadrage.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {offers.map((o) => (
          <article class="card flex flex-col">
            <h3 class="text-lg font-semibold">{o.name}</h3>
            <p class="mt-2 flex-1 text-muted">{o.text}</p>
            <p class="mt-4 text-xl font-bold text-brand">{o.price}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-sm text-muted">
        Prix hors taxes. <Todo value="[à compléter : mention de TVA selon le statut juridique]" />
      </p>
    </div>
  </section>

  <section id="engagements" class="border-y border-line bg-card section" aria-labelledby="engagements-titre">
    <div class="container-page">
      <p class="eyebrow">Propriété et maintenance</p>
      <h2 id="engagements-titre" class="h2">Votre outil vous appartient, et vous pouvez continuer sans moi</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {commitments.map((c) => (
          <div class="card bg-paper">
            <h3 class="font-semibold">{c.title}</h3>
            <p class="mt-2 text-muted">{c.text}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-14 text-xl font-bold">Après la livraison</h3>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {afterDelivery.map((a) => (
          <div class="card bg-paper">
            <h4 class="font-semibold">{a.title}</h4>
            <p class="mt-2 text-muted">{a.text}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-14 text-xl font-bold">Ce que je ne fais pas</h3>
      <p class="mt-2 max-w-2xl text-muted">
        Je laisse de côté les logiciels encadrés par des règles légales lourdes, et je relie mes outils à eux.
      </p>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {notDone.map((n) => (
          <div class="card bg-paper">
            <h4 class="font-semibold">{n.title}</h4>
            <p class="mt-2 text-muted">{n.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="a-propos" class="section" aria-labelledby="apropos-titre">
    <div class="container-page grid items-start gap-10 md:grid-cols-[200px_1fr]">
      <div class="flex aspect-square w-40 items-center justify-center rounded-2xl border border-dashed border-line bg-card text-center text-sm text-muted md:w-full">
        <Todo value="[photo à compléter]" />
      </div>
      <div>
        <p class="eyebrow">À propos</p>
        <h2 id="apropos-titre" class="h2"><Todo value={site.ownerName} />, ingénieur logiciel à Marseille</h2>
        <p class="lead">
          15 ans d'expérience dans le marketing mobile, le transport routier et le recrutement.
        </p>
        <p class="mt-4 max-w-2xl">
          Je travaille par itérations : je livre dès qu'une version est utilisable, puis je l'améliore avec vos retours. De ces années, je garde deux choses : comprendre vite un nouveau métier, et faire des outils simples à utiliser sur le terrain, depuis un téléphone.
        </p>
        <p class="mt-4 max-w-2xl text-muted"><Todo value="[parcours détaillé à compléter]" /></p>
      </div>
    </div>
  </section>

  <section id="faq" class="border-y border-line bg-card section" aria-labelledby="faq-titre">
    <div class="container-page">
      <p class="eyebrow">Questions fréquentes</p>
      <h2 id="faq-titre" class="h2">Vos questions</h2>
      <div class="mt-8 divide-y divide-line rounded-2xl border border-line bg-paper">
        {faq.map((item) => (
          <details class="group px-5 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <span aria-hidden="true" class="text-xl text-brand transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-titre">
    <div class="container-page">
      <div class="rounded-3xl bg-brand px-6 py-12 text-white sm:px-12">
        <h2 id="contact-titre" class="text-2xl font-bold sm:text-3xl">Parlons de la tâche qui vous prend le plus de temps</h2>
        <p class="mt-4 max-w-2xl text-white/85">
          15 minutes pour comprendre votre problème et voir si je peux aider. Gratuit et sans engagement.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <CallButton class="bg-white !text-brand hover:bg-brand-soft" />
        </div>
        <dl class="mt-10 grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="text-sm text-white/70">Téléphone</dt>
            <dd class="mt-1 font-semibold">
              {site.phone ? <a href={`tel:${site.phone}`} class="underline">{site.phoneDisplay}</a> : <Todo value={site.phoneDisplay} />}
            </dd>
          </div>
          <div>
            <dt class="text-sm text-white/70">Email</dt>
            <dd class="mt-1 font-semibold">
              {site.email ? <a href={`mailto:${site.email}`} class="underline">{site.email}</a> : <Todo />}
            </dd>
          </div>
          <div>
            <dt class="text-sm text-white/70">Zone d'intervention</dt>
            <dd class="mt-1 font-semibold">{site.area}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>
